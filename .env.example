# ==========================================================================
# Content Expiry Scanner · plantilla de configuración
# Copia este archivo como .env y completa tus valores.
# El archivo .env NO se sube a git. Nunca pongas secretos reales aquí.
# Tras editar el .env, reinicia uvicorn: los cambios no se aplican en caliente.
# ==========================================================================

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/scanner.db

# --- Reglas de negocio ---
# (La ventana de «próximo a vencer» es fija en 60 días en extractors.py)
YEAR_END_MONTH=12
YEAR_END_DAY=31

# --- Crawler ---
# 0 = sin límite: recorre todo lo alcanzable desde la URL elegida.
MAX_PAGES_PER_SCAN=0
MAX_DEPTH=0
PAGE_TIMEOUT_MS=45000
REQUEST_DELAY_SECONDS=1.0
HEADLESS=true
USER_AGENT=AZ-Content-Scanner/1.0 (internal audit pilot)

# --- OCR de imágenes ---
# Déjalo vacío si tesseract está en PATH. En Windows puedes poner la ruta, p. ej.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGS=eng+spa+por
OCR_BOTTOM_STRIP=0.30
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=100


# --- IA opcional (modelos locales con Ollama) ---
ENABLE_VLM=false
VLM_ENDPOINT=http://localhost:11434/api/generate
VLM_MODEL=llava
ENABLE_LLM_SUMMARY=false
LLM_MODEL=llama3

# --- Kaltura (opcional; requiere credenciales del equipo dueño de la plataforma) ---
ENABLE_KALTURA=false
KALTURA_SERVICE_URL=https://www.kaltura.com
KALTURA_PARTNER_ID=0
KALTURA_ADMIN_SECRET=

# --- Veeva Vault (opcional; requiere una cuenta de integración) ---
ENABLE_VEEVA=false
VEEVA_DNS=
VEEVA_USERNAME=
VEEVA_PASSWORD=
VEEVA_API_VERSION=v24.1

# --- Seguridad del dashboard ---
# Sin contraseña, el servicio SOLO acepta conexiones desde esta máquina.
# Para compartirlo: define DASHBOARD_PASSWORD y añade el servidor a ALLOWED_HOSTS.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOW_PRIVATE_NETWORKS=false

# --- Sesión guiada (AzMed / Veeva / Kaltura) ---
# URL que se abre en cada paso del navegador de login. Cámbialas si el portal
# de tu mercado usa otra entrada.
AUTH_AZMED_URL=https://www.azmed.cr/
AUTH_VEEVA_URL=https://login.veevavault.com/auth/login?retURL=https%3A%2F%2Fastrazeneca-promomats.veevavault.com%2Fui%2F
AUTH_KALTURA_URL=https://kmc.kaltura.com/index.php/kmcng/login
# Navegador del login: auto (Chrome/Edge instalado, luego Chromium), chromium,
# chrome o edge. Safari no se puede automatizar; en Mac usa Chrome, Edge o Chromium.
AUTH_BROWSER=auto
# Tiempo máximo por plataforma y para toda la ventana de login (segundos).
AUTH_STEP_TIMEOUT_SECONDS=300
AUTH_PREP_MAX_SECONDS=1200

# --- Login del crawler (Identity de AstraZeneca) ---
# OPCIÓN RECOMENDADA: usar la pantalla inicial de sesión del dashboard
# («Iniciar sesión»), que abre el navegador elegido y recorre
# AzMed -> Veeva -> Kaltura detectando el acceso.
# También vale el modo clásico, iniciando sesión a mano una vez (admite MFA):
#     python -m scripts.save_session --url https://www.azmed.cr/
# Se guarda data/auth_state.json (cookies) y data/kaltura_session.json (token KS
# de KMC) y el crawler los reutiliza. No necesita las variables de abajo.
#
# OPCIÓN ALTERNATIVA (solo cuentas de servicio SIN MFA): credenciales en tu .env.
# Usa una cuenta dedicada de SOLO LECTURA aprobada por IT. Nunca tu cuenta personal.
CRAWLER_LOGIN_USERNAME=
CRAWLER_LOGIN_PASSWORD=

# Hosts del Identity además de identity/login/sso.astrazeneca.com (separados por coma)
CRAWLER_IDENTITY_HOSTS=

# Selectores del formulario. Déjalos vacíos para usar los predeterminados.
CRAWLER_LOGIN_FIELD_USER=
CRAWLER_LOGIN_FIELD_PASSWORD=
CRAWLER_LOGIN_SUBMIT=

# Login en el propio sitio (no en el Identity). Normalmente vacío.
CRAWLER_LOGIN_URL=
CRAWLER_LOGIN_HOSTS=

# Segundo factor ESTÁTICO (no sirve para TOTP). Para MFA usa save_session.py.
CRAWLER_MFA_FIELD=
CRAWLER_MFA_CODE=

# Heredadas: siguen funcionando, pero usa las CRAWLER_LOGIN_* de arriba
CRAWLER_HTTP_USERNAME=
CRAWLER_HTTP_PASSWORD=

# Parada ordenada cuando no hay sesión válida
# Páginas SEGUIDAS que piden login antes de detener el escaneo (0 = nunca)
CRAWLER_MAX_AUTH_PAGES=8
# Tope TOTAL de páginas protegidas (0 = sin tope)
CRAWLER_MAX_AUTH_TOTAL=0

# --- Approval ID: prefijos adicionales (opcional) ---
# Formato: PREFIJO:MERCADO,PREFIJO:MERCADO
APPROVAL_PREFIXES_EXTRA=

# --- Métricas del piloto ---
MANUAL_MINUTES_PER_PAGE=6